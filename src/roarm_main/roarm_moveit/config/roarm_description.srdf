<?xml version="1.0" encoding="UTF-8"?>
<robot name="roarm_description">
    <group name="arm">
        <joint name="virtual_joint"/>
        <joint name="base_link_to_link1"/>
        <joint name="link1_to_link2"/>
        <joint name="link2_to_link3"/>
        <joint name="link3_to_hand_tcp"/>
    </group>
    <group name="gripper">
        <joint name="link3_to_gripper_link"/>
    </group>
    <group_state name="straight_pose" group="arm">
        <joint name="base_link_to_link1" value="0.0001"/>
        <joint name="link1_to_link2" value="0.0003"/>
        <joint name="link2_to_link3" value="0.0007"/>
    </group_state>
    <group_state name="open_grip" group="gripper">
        <joint name="link3_to_gripper_link" value="1.5"/>
    </group_state>
    <end_effector name="hand_gripper" parent_link="hand_tcp" group="gripper" parent_group="arm"/>
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

    <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="link2" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>

    <disable_collisions link1="base_link" link2="ugv_base_link" reason="Never"/>
    <disable_collisions link1="link1" link2="ugv_base_link" reason="Never"/>
    <disable_collisions link1="link2" link2="ugv_base_link" reason="Never"/>
    <disable_collisions link1="link3" link2="ugv_base_link" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="ugv_base_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="oak_d_pro_link" reason="Never"/>
    <disable_collisions link1="link1" link2="oak_d_pro_link" reason="Never"/>
    <disable_collisions link1="link2" link2="oak_d_pro_link" reason="Never"/>
    <disable_collisions link1="link3" link2="oak_d_pro_link" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="oak_d_pro_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="ugv_left_up_wheel_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="ugv_left_down_wheel_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="ugv_right_up_wheel_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="ugv_right_down_wheel_link" reason="Never"/>
    <disable_collisions link1="link1" link2="ugv_left_up_wheel_link" reason="Never"/>
    <disable_collisions link1="link1" link2="ugv_left_down_wheel_link" reason="Never"/>
    <disable_collisions link1="link1" link2="ugv_right_up_wheel_link" reason="Never"/>
    <disable_collisions link1="link1" link2="ugv_right_down_wheel_link" reason="Never"/>
    <disable_collisions link1="ugv_base_link" link2="oak_d_pro_link" reason="Never"/>
    <disable_collisions link1="ugv_base_link" link2="ugv_left_up_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="ugv_base_link" link2="ugv_left_down_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="ugv_base_link" link2="ugv_right_up_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="ugv_base_link" link2="ugv_right_down_wheel_link" reason="Adjacent"/>
</robot>
